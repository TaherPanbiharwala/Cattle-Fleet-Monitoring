# Shared local credentials. Copy to .env and fill in real values; never commit it.
# Channel 2 (simulated fleet) — used by the simulator in live mode.
THINGSPEAK_WRITE_API_KEY=

# Collar 1 physical firmware — injected into the PlatformIO build only.
WIFI_SSID=
WIFI_PASSWORD=
THINGSPEAK_CHANNEL_1_WRITE_API_KEY=

# Channel 1 (physical Collar 1) — used by the simulator sniffer.
THINGSPEAK_READ_API_KEY=

# Channel 3 (configuration) — used by the simulator config reader.
THINGSPEAK_CONFIG_READ_API_KEY=

# Phase 3 W&B tracking — set as a Kaggle Secret for notebook runs.
WANDB_API_KEY=
WANDB_ENTITY=
WANDB_PROJECT=cattle-fleet-phase3
