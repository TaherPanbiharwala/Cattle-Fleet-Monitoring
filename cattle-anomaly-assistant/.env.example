# cattle-anomaly-assistant credentials. Copy to .env and fill in real
# values; never commit it (the root .gitignore's `.env` pattern covers
# this file too, matched at any depth).
#
# Used by stage2_rag_assistant/llm/providers/openrouter_provider.py when
# config/openrouter.yaml (llm.provider: openrouter) is selected. Export it
# in your shell, or source this file yourself (e.g. `set -a && source .env
# && set +a`) — nothing in this project loads .env automatically.
OPENROUTER_API_KEY=
